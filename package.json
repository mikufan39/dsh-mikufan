{
  "name": "dsh-mikufan",
  "version": "0.10.3",
  "private": true,
  "license": "MIT",
  "description": "Mikufan tools for DeepSeek Harness: delete marked sessions on the next startup, a five-second startup splash, local long-term memory, a no-token LAN access proxy that stays off on every launch, a skills manager with a bundled skill-creator, and an editor for the user-global ~/.dsh/AGENTS.md — all managed from the sidebar Control panel.",
  "type": "module",
  "icon": "./icon.jpg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./splash": "./splash.js",
    "./memory": "./memory.js",
    "./lan": "./lan.js",
    "./skills": "./skills.js",
    "./agent": "./agent.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg"
  },
  "files": [
    "index.js",
    "memory.js",
    "lan.js",
    "skills.js",
    "agent.js",
    "splash.js",
    "client.js",
    "cordis.patch.yml",
    "skills/**",
    "splash/index.html",
    "splash/embed-bridge.html",
    "locale/*.json",
    "icon.jpg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
