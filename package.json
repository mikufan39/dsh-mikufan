{
  "name": "dsh-mikufan",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "魔法未来为dsh增加/强化了几个功能：删除会话、启动动画、记忆、局域网访问、Skills管理、Agent自定义和MCP管理。",
  "type": "module",
  "icon": "./icon.jpg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./splash": "./splash.js",
    "./memory": "./memory.js",
    "./lan": "./lan.js",
    "./skills": "./skills.js",
    "./agent": "./agent.js",
    "./mcp": "./mcp.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg"
  },
  "files": [
    "index.js",
    "memory.js",
    "lan.js",
    "skills.js",
    "agent.js",
    "mcp.js",
    "splash.js",
    "client.js",
    "cordis.patch.yml",
    "skills/**",
    "splash/index.html",
    "splash/embed-bridge.html",
    "locale/*.json",
    "icon.jpg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
